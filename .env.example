# Forge SDLC Manager — Environment Configuration
# Copy to .env and fill in values. DO NOT commit .env to git.

# ── PRIMARY: Groq (Recommended — free, no credit card) ───────
# Sign up at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant       # faster, lighter

# ── FALLBACK: Ollama (local, offline, no rate limits) ────────
# Download Ollama: https://ollama.ai
# Pull model:      ollama pull llama3.3
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.3

# ── ALTERNATIVE: Gemini (also free tier) ─────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Force a specific provider (optional) ─────────────────────
# LLM_PROVIDER=groq        # or: ollama, gemini, openai, anthropic, stub

# ── Forge settings ───────────────────────────────────────────
# FORGE_DB=forge.db
# FORGE_VERBOSE=0

# ── Essence project path (for git/file tools) ────────────────
# ESSENCE_PATH=/path/to/essence_project
